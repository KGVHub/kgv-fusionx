From ee84e7cd4da82bddbff4fcabb3d0412502f2c0b3 Mon Sep 17 00:00:00 2001
From: kgvarunkanth <kgvarunkanth@gmail.com>
Date: Fri, 30 Oct 2026 09:32:13 +0530
Subject: [PATCH] libbinder: fix host build with 32-bit binder

With binder32bit, binder_size_t and binder_uintptr_t are 32 bits, so
casting them straight to a pointer fails -Werror=int-to-pointer-cast on
the 64-bit host libbinder. Widen them first, like the other fields.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Ief75706bf7c7c9284e460909cd0b829af45dec22
---
 libs/binder/IPCThreadState.cpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/libs/binder/IPCThreadState.cpp b/libs/binder/IPCThreadState.cpp
index a62425e984..39b78623fd 100644
--- a/libs/binder/IPCThreadState.cpp
+++ b/libs/binder/IPCThreadState.cpp
@@ -136,9 +136,9 @@ static const void* printBinderTransactionData(TextOutput& out, const void* data)
     }
     out << " (cookie " << btd->cookie << ")" << endl
         << "code=" << TypeCode(btd->code) << ", flags=" << (void*)(uint64_t)btd->flags << endl
-        << "data=" << btd->data.ptr.buffer << " (" << (void*)btd->data_size
+        << "data=" << btd->data.ptr.buffer << " (" << (void*)(uint64_t)btd->data_size
         << " bytes)" << endl
-        << "offsets=" << btd->data.ptr.offsets << " (" << (void*)btd->offsets_size
+        << "offsets=" << btd->data.ptr.offsets << " (" << (void*)(uint64_t)btd->offsets_size
         << " bytes)";
     return btd+1;
 }
@@ -1026,7 +1026,7 @@ status_t IPCThreadState::talkWithDriver(bool doReceive)
         TextOutput::Bundle _b(alog);
         if (outAvail != 0) {
             alog << "Sending commands to driver: " << indent;
-            const void* cmds = (const void*)bwr.write_buffer;
+            const void* cmds = (const void*)(uintptr_t)bwr.write_buffer;
             const void* end = ((const uint8_t*)cmds)+bwr.write_size;
             alog << HexDump(cmds, bwr.write_size) << endl;
             while (cmds < end) cmds = printCommand(alog, cmds);
-- 
2.53.0

