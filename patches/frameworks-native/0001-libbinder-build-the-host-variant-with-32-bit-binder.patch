From ee5a6d13c9143648e68c4a326c8d9bbefcae286f Mon Sep 17 00:00:00 2001
From: kgvarunkanth <kgvarunkanth@gmail.com>
Date: Fri, 30 Oct 2026 09:25:03 +0530
Subject: [PATCH] libbinder: build the host variant with 32-bit binder

binder32bit makes binder_size_t and binder_uintptr_t 32 bits. The 64-bit
host libbinder casts them to void* in its debug printers, which fails
-Werror=int-to-void-pointer-cast. Host libbinder never uses kernel binder,
so silence that warning for host only.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I37819a1d59841a8c6ceebf2fd59d28485ec798c3
---
 libs/binder/Android.bp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/libs/binder/Android.bp b/libs/binder/Android.bp
index d8d2cf2652..6759361357 100644
--- a/libs/binder/Android.bp
+++ b/libs/binder/Android.bp
@@ -148,6 +148,10 @@ cc_library {
                 "ServiceManagerHost.cpp",
                 "UtilsHost.cpp",
             ],
+            // With binder32bit, binder_size_t/binder_uintptr_t are 32 bits;
+            // the debug printers cast them to pointers, which only warns on
+            // a 64-bit host. Host libbinder never talks to kernel binder.
+            cflags: ["-Wno-int-to-void-pointer-cast"],
         },
         recovery: {
             exclude_header_libs: [
-- 
2.53.0

