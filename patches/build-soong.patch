From adecd4a679adb81589b63f9eae6cf3843427b0c9 Mon Sep 17 00:00:00 2001
From: kgvarunkanth <kgvarunkanth@gmail.com>
Date: Sun, 25 Oct 2026 07:02:46 +0530
Subject: [PATCH] soong: pass low-memory settings through and cap Java tools

soong_build gets GOGC, GOMEMLIMIT, GOMAXPROCS and the BLUEPRINT_* low-memory
switches from the environment, can write heap profiles as it grows
(SOONG_HEAP_PROFILE_DIR), and ninja passes JAVA_TOOL_OPTIONS to build jobs.
In low-memory mode every metalava job runs in the highmem pool, one at a
time, with a 3 GB heap and the serial GC.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I836200572c0045f305b22947989f181f9eb71964
---
 cmd/soong_build/main.go | 28 ++++++++++++++++++++++++++++
 java/droidstubs.go      | 13 ++++++++++---
 ui/build/ninja.go       |  2 ++
 ui/build/soong.go       | 10 ++++++++++
 4 files changed, 50 insertions(+), 3 deletions(-)

diff --git a/cmd/soong_build/main.go b/cmd/soong_build/main.go
index f1884a7..fc9c857 100644
--- a/cmd/soong_build/main.go
+++ b/cmd/soong_build/main.go
@@ -20,6 +20,8 @@ import (
 	"io/ioutil"
 	"os"
 	"path/filepath"
+	"runtime"
+	"runtime/pprof"
 	"strings"
 	"time"
 
@@ -335,9 +337,35 @@ func parseAvailableEnv() map[string]string {
 	return result
 }
 
+// writeHeapProfiles snapshots the heap to dir each time it grows by another
+// 500MB, so a run killed for memory still leaves a profile of what filled it.
+func writeHeapProfiles(dir string) {
+	var stats runtime.MemStats
+	next := uint64(1 << 30)
+	for i := 0; ; {
+		time.Sleep(2 * time.Second)
+		runtime.ReadMemStats(&stats)
+		if stats.HeapAlloc < next {
+			continue
+		}
+		next = stats.HeapAlloc + 500<<20
+		f, err := os.Create(filepath.Join(dir, fmt.Sprintf("heap-%03d-%dM.prof", i, stats.HeapAlloc>>20)))
+		if err != nil {
+			return
+		}
+		pprof.WriteHeapProfile(f)
+		f.Close()
+		i++
+	}
+}
+
 func main() {
 	flag.Parse()
 
+	if dir := os.Getenv("SOONG_HEAP_PROFILE_DIR"); dir != "" {
+		go writeHeapProfiles(dir)
+	}
+
 	shared.ReexecWithDelveMaybe(delveListen, delvePath)
 	android.InitSandbox(topDir)
 
diff --git a/java/droidstubs.go b/java/droidstubs.go
index 3b1f7c0..e42a440 100644
--- a/java/droidstubs.go
+++ b/java/droidstubs.go
@@ -461,8 +461,13 @@ func metalavaCmd(ctx android.ModuleContext, rule *android.RuleBuilder, javaVersi
 
 	cmd.BuiltTool("metalava").ImplicitTool(ctx.Config().HostJavaToolPath(ctx, "metalava.jar")).
 		Flag(config.JavacVmFlags).
-		Flag("-J--add-opens=java.base/java.util=ALL-UNNAMED").
-		FlagWithArg("-encoding ", "UTF-8").
+		Flag("-J--add-opens=java.base/java.util=ALL-UNNAMED")
+	if ctx.Config().IsEnvTrue("BLUEPRINT_COMPACT_ACTIONS") {
+		// Cap the heap and use the serial collector, which needs far less
+		// memory beyond the heap than G1. These jobs run one at a time.
+		cmd.Flag("-J-Xmx3g").Flag("-J-XX:+UseSerialGC").Flag("-J-XX:TieredStopAtLevel=1")
+	}
+	cmd.FlagWithArg("-encoding ", "UTF-8").
 		FlagWithArg("-source ", javaVersion.String()).
 		FlagWithRspFileInputList("@", android.PathForModuleOut(ctx, "metalava.rsp"), srcs).
 		FlagWithInput("@", srcJarList)
@@ -503,8 +508,10 @@ func (d *Droidstubs) GenerateAndroidBuildActions(ctx android.ModuleContext) {
 		android.PathForModuleOut(ctx, "metalava.sbox.textproto")).
 		SandboxInputs()
 
-	if BoolDefault(d.properties.High_mem, false) {
+	lowMemory := ctx.Config().IsEnvTrue("BLUEPRINT_COMPACT_ACTIONS")
+	if BoolDefault(d.properties.High_mem, false) || lowMemory {
 		// This metalava run uses lots of memory, restrict the number of metalava jobs that can run in parallel.
+		// Low-memory hosts run every metalava job alone.
 		rule.HighMem()
 	}
 
diff --git a/ui/build/ninja.go b/ui/build/ninja.go
index dab1a9b..2258bb8 100644
--- a/ui/build/ninja.go
+++ b/ui/build/ninja.go
@@ -117,6 +117,8 @@ func runNinjaForBuild(ctx Context, config Config) {
 			"ASAN_SYMBOLIZER_PATH",
 			"HOME",
 			"JAVA_HOME",
+			// Low-memory hosts use it to pick a lighter JVM garbage collector.
+			"JAVA_TOOL_OPTIONS",
 			"LANG",
 			"LC_MESSAGES",
 			"OUT_DIR",
diff --git a/ui/build/soong.go b/ui/build/soong.go
index a0ab1cc..9cf3305 100644
--- a/ui/build/soong.go
+++ b/ui/build/soong.go
@@ -167,6 +167,13 @@ func primaryBuilderInvocation(
 
 	commonArgs = append(commonArgs, "-l", filepath.Join(config.FileListDir(), "Android.bp.list"))
 	invocationEnv := make(map[string]string)
+	// soong_build runs under "env -i"; let low-memory hosts tune its Go
+	// garbage collector (GOGC; GOMEMLIMIT with Go 1.19+).
+	for _, name := range []string{"GOGC", "GOMEMLIMIT", "GOMAXPROCS", "SOONG_HEAP_PROFILE_DIR", "BLUEPRINT_COMPACT_ACTIONS", "BLUEPRINT_VARIANT_STATS", "BLUEPRINT_SKIP_MODULE_TYPES"} {
+		if value, ok := os.LookupEnv(name); ok {
+			invocationEnv[name] = value
+		}
+	}
 	debugMode := os.Getenv("SOONG_DELVE") != ""
 
 	if debugMode {
@@ -248,6 +255,9 @@ func bootstrapBlueprint(ctx Context, config Config) {
 	bootstrapEpochCleanup(ctx, config)
 
 	mainSoongBuildExtraArgs := []string{"-o", config.SoongNinjaFile()}
+	if profile, ok := os.LookupEnv("SOONG_MEMPROFILE"); ok {
+		mainSoongBuildExtraArgs = append(mainSoongBuildExtraArgs, "--memprofile", profile)
+	}
 	if config.EmptyNinjaFile() {
 		mainSoongBuildExtraArgs = append(mainSoongBuildExtraArgs, "--empty-ninja-file")
 	}
-- 
