diff --git a/res/values/kgv_strings.xml b/res/values/kgv_strings.xml
new file mode 100644
index 0000000..0db9d55
--- /dev/null
+++ b/res/values/kgv_strings.xml
@@ -0,0 +1,6 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- KGV FusionX: the KGV X Intelligence entry on the Settings homepage. -->
+<resources>
+    <string name="kgv_intelligence_title" translatable="false">KGV X Intelligence</string>
+    <string name="kgv_intelligence_summary" translatable="false">AI research assistant, phone control, MCP</string>
+</resources>
diff --git a/res/xml/top_level_settings.xml b/res/xml/top_level_settings.xml
index d050a1f..8789e08 100644
--- a/res/xml/top_level_settings.xml
+++ b/res/xml/top_level_settings.xml
@@ -30,6 +30,19 @@
         settings:highlightableMenuKey="@string/menu_key_network"
         settings:controller="com.android.settings.network.TopLevelNetworkEntryPreferenceController"/>
 
+    <!-- KGV FusionX: KGV X Intelligence, between Network & internet and Connected devices. -->
+    <com.android.settings.widget.HomepagePreference
+        android:icon="@drawable/ic_homepage_kgv_intelligence"
+        android:key="top_level_kgv_intelligence"
+        android:order="-147"
+        android:title="@string/kgv_intelligence_title"
+        android:summary="@string/kgv_intelligence_summary">
+        <intent
+            android:action="android.intent.action.MAIN"
+            android:targetPackage="org.kgv.intelligence"
+            android:targetClass="org.kgv.intelligence.SettingsActivity" />
+    </com.android.settings.widget.HomepagePreference>
+
     <com.android.settings.widget.HomepagePreference
         android:fragment="com.android.settings.communal.CommunalDashboardFragment"
         android:icon="@drawable/ia_settings_communal"
