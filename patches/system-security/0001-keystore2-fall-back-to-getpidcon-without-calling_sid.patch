From 363f97dd10111435a2421d3051f1d4c1c77717e4 Mon Sep 17 00:00:00 2001
From: kgvarunkanth <pravinraj@modiarmy.com>
Date: Sat, 31 Oct 2026 15:22:01 +0530
Subject: [PATCH] keystore2: fall back to getpidcon without calling_sid

Kernels without binder security context support (this 4.4 kernel)
never deliver the caller's SID, so every permission check failed with
"Cannot check permission without calling_sid" and AndroidKeyStore
maintenance calls returned SYSTEM_ERROR, crashing LockSettingsService
in system_server after boot. Look up the calling pid's context then.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I08189ff3f4d4f9299bd39df1ccdb881b6f09c218
---
 keystore2/src/utils.rs | 43 +++++++++++++++++++++---------------------
 1 file changed, 22 insertions(+), 21 deletions(-)

diff --git a/keystore2/src/utils.rs b/keystore2/src/utils.rs
index 08d3a8e..803d5ff 100644
--- a/keystore2/src/utils.rs
+++ b/keystore2/src/utils.rs
@@ -43,35 +43,37 @@ use keystore2_apc_compat::{
     APC_COMPAT_ERROR_SYSTEM_ERROR,
 };
 use keystore2_crypto::{aes_gcm_decrypt, aes_gcm_encrypt, ZVec};
+use std::ffi::CStr;
 use std::iter::IntoIterator;
 
+/// Runs `f` with the caller's SELinux context. Kernels without binder security
+/// context support (before 4.14, unless backported) never deliver calling_sid,
+/// so fall back to the context of the calling pid.
+fn with_calling_sid<T>(f: impl FnOnce(&CStr) -> anyhow::Result<T>) -> anyhow::Result<T> {
+    ThreadState::with_calling_sid(|calling_sid| match calling_sid {
+        Some(sid) => f(sid),
+        None => {
+            let ctx = keystore2_selinux::getpidcon(ThreadState::get_calling_pid())
+                .context("Cannot get the caller's context without calling_sid.")?;
+            f(&ctx)
+        }
+    })
+}
+
 /// This function uses its namesake in the permission module and in
 /// combination with with_calling_sid from the binder crate to check
 /// if the caller has the given keystore permission.
 pub fn check_keystore_permission(perm: KeystorePerm) -> anyhow::Result<()> {
-    ThreadState::with_calling_sid(|calling_sid| {
-        permission::check_keystore_permission(
-            calling_sid.ok_or_else(Error::sys).context(
-                "In check_keystore_permission: Cannot check permission without calling_sid.",
-            )?,
-            perm,
-        )
-    })
+    with_calling_sid(|calling_sid| permission::check_keystore_permission(calling_sid, perm))
+        .context("In check_keystore_permission.")
 }
 
 /// This function uses its namesake in the permission module and in
 /// combination with with_calling_sid from the binder crate to check
 /// if the caller has the given grant permission.
 pub fn check_grant_permission(access_vec: KeyPermSet, key: &KeyDescriptor) -> anyhow::Result<()> {
-    ThreadState::with_calling_sid(|calling_sid| {
-        permission::check_grant_permission(
-            calling_sid.ok_or_else(Error::sys).context(
-                "In check_grant_permission: Cannot check permission without calling_sid.",
-            )?,
-            access_vec,
-            key,
-        )
-    })
+    with_calling_sid(|calling_sid| permission::check_grant_permission(calling_sid, access_vec, key))
+        .context("In check_grant_permission.")
 }
 
 /// This function uses its namesake in the permission module and in
@@ -82,17 +84,16 @@ pub fn check_key_permission(
     key: &KeyDescriptor,
     access_vector: &Option<KeyPermSet>,
 ) -> anyhow::Result<()> {
-    ThreadState::with_calling_sid(|calling_sid| {
+    with_calling_sid(|calling_sid| {
         permission::check_key_permission(
             ThreadState::get_calling_uid(),
-            calling_sid
-                .ok_or_else(Error::sys)
-                .context("In check_key_permission: Cannot check permission without calling_sid.")?,
+            calling_sid,
             perm,
             key,
             access_vector,
         )
     })
+    .context("In check_key_permission.")
 }
 
 /// This function checks whether a given tag corresponds to the access of device identifiers.
