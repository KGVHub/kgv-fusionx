From 27d698e770081b95470747a1a6e29a89a8566614 Mon Sep 17 00:00:00 2001
From: kgvarunkanth <kgvarunkanth@gmail.com>
Date: Mon, 2 Nov 2026 13:03:18 +0530
Subject: [PATCH 11/11] mido: kgv_rootd sepolicy, root access on by default

kgv_rootd runs KGV X Intelligence's root commands; it is unconfined
(permissive) on userdebug builds, and only system_app may connect to its
socket. persist.kgv.root=1 is the default; the app switches it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 device.mk                          |  4 ++++
 sepolicy/private/file_contexts     |  2 ++
 sepolicy/private/kgv_rootd.te      | 17 +++++++++++++++++
 sepolicy/private/property_contexts |  1 +
 4 files changed, 24 insertions(+)
 create mode 100644 sepolicy/private/kgv_rootd.te

diff --git a/device.mk b/device.mk
index 8ab6609..cbdb320 100644
--- a/device.mk
+++ b/device.mk
@@ -91,6 +91,10 @@ PRODUCT_PACKAGES += \
 PRODUCT_PACKAGES += \
     KGVIntelligence
 
+# KGV X Intelligence has root (kgv_rootd) unless the user turns it off
+PRODUCT_SYSTEM_EXT_PROPERTIES += \
+    persist.kgv.root=1
+
 # KGV FusionX: on-device Unbound DNS resolver (external/unbound)
 PRODUCT_PACKAGES += \
     unbound
diff --git a/sepolicy/private/file_contexts b/sepolicy/private/file_contexts
index 312aaa2..8e32dcd 100644
--- a/sepolicy/private/file_contexts
+++ b/sepolicy/private/file_contexts
@@ -1,3 +1,5 @@
 /(system_ext|system/system_ext)/bin/unbound             u:object_r:kgv_unbound_exec:s0
 /(system_ext|system/system_ext)/bin/kgv_dns_redirect    u:object_r:kgv_dns_exec:s0
 /data/misc/kgv_unbound(/.*)?                            u:object_r:kgv_unbound_data_file:s0
+/(system_ext|system/system_ext)/bin/kgv_rootd          u:object_r:kgv_rootd_exec:s0
+/dev/socket/kgv_rootd                                   u:object_r:kgv_rootd_socket:s0
diff --git a/sepolicy/private/kgv_rootd.te b/sepolicy/private/kgv_rootd.te
new file mode 100644
index 0000000..3e31b8f
--- /dev/null
+++ b/sepolicy/private/kgv_rootd.te
@@ -0,0 +1,17 @@
+# KGV FusionX: kgv_rootd, which runs KGV X Intelligence's root commands
+# (packages/apps/KGVIntelligence/rootd). The assistant may do anything root can,
+# so the daemon is unconfined like su: permissive, on userdebug builds only.
+type kgv_rootd, domain, coredomain, mlstrustedsubject;
+type kgv_rootd_exec, system_file_type, exec_type, file_type;
+type kgv_rootd_socket, file_type, coredomain_socket, mlstrustedobject;
+
+init_daemon_domain(kgv_rootd)
+userdebug_or_eng(`permissive kgv_rootd;')
+
+# Only KGV X Intelligence (system_app) talks to it; the daemon also checks the
+# peer is the system user.
+unix_socket_connect(system_app, kgv_rootd, kgv_rootd)
+
+# Root access on/off (persist.kgv.root).
+system_internal_prop(kgv_root_prop)
+set_prop(system_app, kgv_root_prop)
diff --git a/sepolicy/private/property_contexts b/sepolicy/private/property_contexts
index bd364b9..b78b345 100644
--- a/sepolicy/private/property_contexts
+++ b/sepolicy/private/property_contexts
@@ -2,3 +2,4 @@ persist.kgv.dns.mode    u:object_r:kgv_dns_mode_prop:s0 exact string
 kgv.dns.                u:object_r:kgv_dns_prop:s0
 persist.kgv.dns.servers u:object_r:kgv_dns_mode_prop:s0 exact string
 persist.kgv.dns.adblock u:object_r:kgv_dns_mode_prop:s0 exact bool
+persist.kgv.root        u:object_r:kgv_root_prop:s0 exact bool
-- 
