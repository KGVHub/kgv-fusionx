From 8e6808d378f3ee8c841e89b06da4b70704fb2243 Mon Sep 17 00:00:00 2001
From: kgvarunkanth <kgvarunkanth@gmail.com>
Date: Sun, 25 Oct 2026 15:11:18 +0530
Subject: [PATCH 4/7] mido: ship the Unbound DNS resolver, with its SELinux
 policy

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 device.mk                          |  4 ++++
 sepolicy/private/file_contexts     |  3 +++
 sepolicy/private/kgv_dns.te        | 27 +++++++++++++++++++++++++++
 sepolicy/private/kgv_props.te      |  6 ++++++
 sepolicy/private/kgv_unbound.te    | 17 +++++++++++++++++
 sepolicy/private/property_contexts |  2 ++
 6 files changed, 59 insertions(+)
 create mode 100644 sepolicy/private/file_contexts
 create mode 100644 sepolicy/private/kgv_dns.te
 create mode 100644 sepolicy/private/kgv_props.te
 create mode 100644 sepolicy/private/kgv_unbound.te
 create mode 100644 sepolicy/private/property_contexts

diff --git a/device.mk b/device.mk
index 04ef69f..8ab6609 100644
--- a/device.mk
+++ b/device.mk
@@ -91,6 +91,10 @@ PRODUCT_PACKAGES += \
 PRODUCT_PACKAGES += \
     KGVIntelligence
 
+# KGV FusionX: on-device Unbound DNS resolver (external/unbound)
+PRODUCT_PACKAGES += \
+    unbound
+
 # Audio
 PRODUCT_PACKAGES += \
     android.hardware.audio@7.1-impl:32 \
diff --git a/sepolicy/private/file_contexts b/sepolicy/private/file_contexts
new file mode 100644
index 0000000..f453d6a
--- /dev/null
+++ b/sepolicy/private/file_contexts
@@ -0,0 +1,3 @@
+/system_ext/bin/unbound             u:object_r:kgv_unbound_exec:s0
+/system_ext/bin/kgv_dns_redirect    u:object_r:kgv_dns_exec:s0
+/data/misc/kgv_unbound(/.*)?        u:object_r:kgv_unbound_data_file:s0
diff --git a/sepolicy/private/kgv_dns.te b/sepolicy/private/kgv_dns.te
new file mode 100644
index 0000000..91d0cc9
--- /dev/null
+++ b/sepolicy/private/kgv_dns.te
@@ -0,0 +1,27 @@
+# KGV FusionX: kgv_dns_redirect, which points every app's DNS at Unbound with
+# iptables and lifts the redirect when Unbound or recursion stops working.
+type kgv_dns, domain, coredomain;
+type kgv_dns_exec, system_file_type, exec_type, file_type;
+
+init_daemon_domain(kgv_dns)
+net_domain(kgv_dns)
+
+allow kgv_dns shell_exec:file rx_file_perms;
+allow kgv_dns toolbox_exec:file rx_file_perms;
+allow kgv_dns system_file:file { rx_file_perms lock };
+
+# iptables / ip6tables
+allow kgv_dns self:capability { net_admin net_raw chown fowner dac_override };
+allow kgv_dns self:rawip_socket create_socket_perms_no_ioctl;
+allow kgv_dns proc_net:file r_file_perms;
+dontaudit kgv_dns kernel:system module_request;
+
+# Health checks (nc) and Unbound's files.
+allow kgv_dns self:tcp_socket create_stream_socket_perms;
+allow kgv_dns kgv_unbound_data_file:dir rw_dir_perms;
+allow kgv_dns kgv_unbound_data_file:file { create_file_perms setattr };
+allow kgv_dns system_security_cacerts_file:dir r_dir_perms;
+allow kgv_dns system_security_cacerts_file:file r_file_perms;
+
+get_prop(kgv_dns, kgv_dns_mode_prop)
+set_prop(kgv_dns, kgv_dns_prop)
diff --git a/sepolicy/private/kgv_props.te b/sepolicy/private/kgv_props.te
new file mode 100644
index 0000000..9c4fc51
--- /dev/null
+++ b/sepolicy/private/kgv_props.te
@@ -0,0 +1,6 @@
+# KGV FusionX DNS: the mode KGV X Intelligence chooses, and the resolver state.
+system_internal_prop(kgv_dns_mode_prop)
+system_internal_prop(kgv_dns_prop)
+
+set_prop(system_app, kgv_dns_mode_prop)
+get_prop(system_app, kgv_dns_prop)
diff --git a/sepolicy/private/kgv_unbound.te b/sepolicy/private/kgv_unbound.te
new file mode 100644
index 0000000..1296762
--- /dev/null
+++ b/sepolicy/private/kgv_unbound.te
@@ -0,0 +1,17 @@
+# KGV FusionX: Unbound, the on-device DNS resolver (external/unbound).
+type kgv_unbound, domain, coredomain;
+type kgv_unbound_exec, system_file_type, exec_type, file_type;
+type kgv_unbound_data_file, file_type, data_file_type, core_data_file_type;
+
+init_daemon_domain(kgv_unbound)
+net_domain(kgv_unbound)
+
+# Listen on 127.0.0.1/::1 port 5353 and query DNS servers.
+allow kgv_unbound self:udp_socket create_socket_perms;
+allow kgv_unbound self:tcp_socket create_stream_socket_perms;
+allow kgv_unbound port:{ udp_socket tcp_socket } name_bind;
+allow kgv_unbound node:{ udp_socket tcp_socket } node_bind;
+
+# Cache directory with the self-updating DNSSEC trust anchor.
+allow kgv_unbound kgv_unbound_data_file:dir rw_dir_perms;
+allow kgv_unbound kgv_unbound_data_file:file create_file_perms;
diff --git a/sepolicy/private/property_contexts b/sepolicy/private/property_contexts
new file mode 100644
index 0000000..8cf4748
--- /dev/null
+++ b/sepolicy/private/property_contexts
@@ -0,0 +1,2 @@
+persist.kgv.dns.mode    u:object_r:kgv_dns_mode_prop:s0 exact string
+kgv.dns.                u:object_r:kgv_dns_prop:s0
-- 
