From 47bf5a2f1b26ce7905a92ab4f9daddcc0ae4b556 Mon Sep 17 00:00:00 2001
From: kgvarunkanth <kgvarunkanth@gmail.com>
Date: Sun, 25 Oct 2026 08:40:30 +0530
Subject: [PATCH 3/7] mido: ship KGV X Intelligence as the default assistant

Adds the app, makes it config_defaultAssistant and turns on window blur
for its chat sheet; SystemUI keeps its own blurs off for speed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 device.mk                                              | 4 ++++
 overlay/frameworks/base/core/res/res/values/config.xml | 2 +-
 system.prop                                            | 4 ++++
 3 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/device.mk b/device.mk
index 8347ab2..04ef69f 100644
--- a/device.mk
+++ b/device.mk
@@ -87,6 +87,10 @@ PRODUCT_COPY_FILES += \
 PRODUCT_PACKAGES += \
     AntHalService
 
+# KGV X Intelligence
+PRODUCT_PACKAGES += \
+    KGVIntelligence
+
 # Audio
 PRODUCT_PACKAGES += \
     android.hardware.audio@7.1-impl:32 \
diff --git a/overlay/frameworks/base/core/res/res/values/config.xml b/overlay/frameworks/base/core/res/res/values/config.xml
index a6e35b4..7bce942 100644
--- a/overlay/frameworks/base/core/res/res/values/config.xml
+++ b/overlay/frameworks/base/core/res/res/values/config.xml
@@ -480,7 +480,7 @@
     <bool name="config_smart_battery_available">true</bool>
 
     <!-- The name of the package that will hold the assistant role by default. -->
-    <string name="config_defaultAssistant" translatable="false">com.google.android.googlequicksearchbox</string>
+    <string name="config_defaultAssistant" translatable="false">org.kgv.intelligence</string>
     
     <!-- List of biometric sensors on the device, in decreasing strength. Consumed by AuthService
          when registering authenticators with BiometricService. Format must be ID:Modality:Strength,
diff --git a/system.prop b/system.prop
index aee7143..d385949 100644
--- a/system.prop
+++ b/system.prop
@@ -132,6 +132,10 @@ ro.surface_flinger.enable_layer_caching=true
 ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
 ro.surface_flinger.max_frame_buffer_acquired_buffers=3
 ro.surface_flinger.max_virtual_display_dimension=4096
+# Window blur for KGV X Intelligence; SystemUI keeps its own blurs off for speed.
+ro.surface_flinger.supports_background_blur=1
+ro.sf.blurs_are_expensive=1
+persist.sysui.disableBlur=1
 
 # System
 persist.sys.binary_xml=false
-- 
2.53.0

