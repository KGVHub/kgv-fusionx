From d3c8c27535013c7242ec711ad8bc01ba594f0a6a Mon Sep 17 00:00:00 2001
From: kgvarunkanth <pravinraj@modiarmy.com>
Date: Fri, 30 Oct 2026 23:05:18 +0530
Subject: [PATCH] bpfloader: skip loading on kernels older than 4.9

Android 13's eBPF programs need kernel 4.9+. On 4.4 loading fails and
bpfloader's reboot_on_failure bootloops the device. Load nothing, set
bpf.progs_loaded so dependent services start, and let netd and the
network stack use their non-eBPF paths.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Ife4cd24bff255ff309d8c3a23f0fe7d0de555bf8
---
 bpfloader/BpfLoader.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/bpfloader/BpfLoader.cpp b/bpfloader/BpfLoader.cpp
index 5cd80b7..4d6d251 100644
--- a/bpfloader/BpfLoader.cpp
+++ b/bpfloader/BpfLoader.cpp
@@ -178,6 +178,18 @@ int main(int argc, char** argv) {
     (void)argc;
     android::base::InitLogging(argv, &android::base::KernelLogger);
 
+    // Kernels older than 4.9 (e.g. 4.4 on legacy devices) can't run the
+    // Android 13 eBPF programs. Load nothing and report success, so netd and
+    // the network stack take their non-eBPF paths instead of rebooting.
+    if (!android::bpf::isAtLeastKernelVersion(4, 9, 0)) {
+        ALOGI("kernel older than 4.9: not loading eBPF programs");
+        if (!android::base::SetProperty("bpf.progs_loaded", "1")) {
+            ALOGE("Failed to set bpf.progs_loaded property");
+            return 1;
+        }
+        return 0;
+    }
+
     // Create all the pin subdirectories
     // (this must be done first to allow selinux_context and pin_subdir functionality,
     //  which could otherwise fail with ENOENT during object pinning or renaming,
