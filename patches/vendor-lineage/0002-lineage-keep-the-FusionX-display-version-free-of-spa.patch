From f4b791ff7e3ddd435e014bc16302102a2ffe4edf Mon Sep 17 00:00:00 2001
From: kgvarunkanth <kgvarunkanth@gmail.com>
Date: Sun, 25 Oct 2026 07:43:56 +0530
Subject: [PATCH 2/2] lineage: keep the FusionX display version free of spaces

ro.lineage.display.version is passed as a word list, so "KGV FusionX 1.0
(date)" came out as "KGV". About phone already labels it "KGV FusionX
version"; the value is now 1.0-<date>.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I6f9e58255eded400fb6dcecf7afb2134b769b57d
---
 config/version.mk | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/config/version.mk b/config/version.mk
index 18e1de5..9f4968b 100644
--- a/config/version.mk
+++ b/config/version.mk
@@ -38,4 +38,5 @@ LINEAGE_VERSION := $(PRODUCT_VERSION_MAJOR).$(PRODUCT_VERSION_MINOR)-$(LINEAGE_V
 # KGV FusionX branding. ro.lineage.version stays LineageOS-compatible.
 FUSIONX_VERSION := 1.0
 FUSIONX_BUILD_DATE := $(shell date -u +%Y%m%d)
-LINEAGE_DISPLAY_VERSION := KGV FusionX $(FUSIONX_VERSION) ($(FUSIONX_BUILD_DATE))
+# No spaces: system properties are listed as words.
+LINEAGE_DISPLAY_VERSION := $(FUSIONX_VERSION)-$(FUSIONX_BUILD_DATE)
-- 
2.53.0

