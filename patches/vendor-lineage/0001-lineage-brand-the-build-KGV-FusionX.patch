From 5fcc33c9f32009a735eb8233a3c11758701fa998 Mon Sep 17 00:00:00 2001
From: kgvarunkanth <kgvarunkanth@gmail.com>
Date: Sun, 25 Oct 2026 07:26:55 +0530
Subject: [PATCH] lineage: brand the build KGV FusionX

About phone shows "KGV FusionX 1.0 (<date>)" as the version and the zip
is KGV-FusionX-<version>-<date>-<device>.zip. ro.lineage.version keeps
its LineageOS form so tools that parse it keep working.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Id482425b19036385f75d65ca44ab9fc4f04ceea8
---
 build/tasks/bacon.mk | 2 +-
 config/version.mk    | 5 ++++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/build/tasks/bacon.mk b/build/tasks/bacon.mk
index 4f8bedc..8f08f9b 100644
--- a/build/tasks/bacon.mk
+++ b/build/tasks/bacon.mk
@@ -16,7 +16,7 @@
 # -----------------------------------------------------------------
 # Lineage OTA update package
 
-LINEAGE_TARGET_PACKAGE := $(PRODUCT_OUT)/lineage-$(LINEAGE_VERSION).zip
+LINEAGE_TARGET_PACKAGE := $(PRODUCT_OUT)/KGV-FusionX-$(FUSIONX_VERSION)-$(FUSIONX_BUILD_DATE)-$(LINEAGE_BUILD).zip
 
 SHA256 := prebuilts/build-tools/path/$(HOST_PREBUILT_TAG)/sha256sum
 
diff --git a/config/version.mk b/config/version.mk
index 0d15a03..18e1de5 100644
--- a/config/version.mk
+++ b/config/version.mk
@@ -35,4 +35,7 @@ LINEAGE_VERSION_SUFFIX := $(LINEAGE_BUILD_DATE)-$(LINEAGE_BUILDTYPE)$(LINEAGE_EX
 LINEAGE_VERSION := $(PRODUCT_VERSION_MAJOR).$(PRODUCT_VERSION_MINOR)-$(LINEAGE_VERSION_SUFFIX)
 
 # Display version
-LINEAGE_DISPLAY_VERSION := $(PRODUCT_VERSION_MAJOR)-$(LINEAGE_VERSION_SUFFIX)
+# KGV FusionX branding. ro.lineage.version stays LineageOS-compatible.
+FUSIONX_VERSION := 1.0
+FUSIONX_BUILD_DATE := $(shell date -u +%Y%m%d)
+LINEAGE_DISPLAY_VERSION := KGV FusionX $(FUSIONX_VERSION) ($(FUSIONX_BUILD_DATE))
-- 
2.53.0

