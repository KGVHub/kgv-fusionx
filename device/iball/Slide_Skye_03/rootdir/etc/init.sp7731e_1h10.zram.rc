# zram swap: half of the 925 MB RAM, LZ4-compressed (the zram0 entry in
# fstab.sp7731e_1h10). fs_mgr has no compression option, so pick LZ4 before
# swapon_all sizes the device (the kernel default is the slower LZO).
on post-fs-data
    write /sys/block/zram0/comp_algorithm lz4
    swapon_all /vendor/etc/fstab.${ro.hardware}
    # Swap to zram readily, one page at a time (no readahead on a RAM disk).
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/page-cluster 0
