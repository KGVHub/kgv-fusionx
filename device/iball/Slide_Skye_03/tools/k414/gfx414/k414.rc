# KGV: kernel 4.14 mode (androidboot.k414=1 from the 4.14 boot image's
# bootargs). The 8.1 graphics stack needs ADF and Mali r21 (kernel 4.4); on
# 4.14 the Nokia C1 2E (Android 11) DRM hwcomposer, ION gralloc and Mali
# r28p0 user driver are bind-mounted over the stock files, and the 4.14
# kernel modules over /vendor/lib/modules. On 4.4 nothing changes.
on early-init && property:ro.boot.k414=1
    mount none /vendor/k414/modules /vendor/lib/modules bind
    mount none /vendor/k414/lib/hw/gralloc.sp7731e.so /vendor/lib/hw/gralloc.sp7731e.so bind
    mount none /vendor/k414/lib/hw/hwcomposer.sp7731e.so /vendor/lib/hw/hwcomposer.sp7731e.so bind
    mount none /vendor/k414/lib/egl/libGLES_mali.so /vendor/lib/egl/libGLES_mali.so bind
    mount none /vendor/k414/lib/libmemion.so /vendor/lib/libmemion.so bind

# Performance on 4.14 (measured with perf/jank.sh, app drawer scroll):
# the GPU's simple_ondemand sat at 384 MHz; Unisoc's dynamic CPU hotplug kept
# failing to unplug cpu3. GPU floor 533 MHz and hotplug off cut the 90th
# percentile frame from 97 to ~61 ms.
on boot && property:ro.boot.k414=1
    write /sys/class/devfreq/60000000.gpu/max_freq 600000000
    write /sys/class/devfreq/60000000.gpu/min_freq 533000000
    write /sys/devices/system/cpu/cpuhotplug/dynamic_load_disable 1
