// KGV X Intelligence: the KGV FusionX assistant.

android_app {
    name: "KGVIntelligence",
    // SettingsLib and its dependencies: the settings pages look like stock Settings.
    defaults: ["SettingsLibDefaults"],
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    static_libs: ["kgv-browser-api"],
    required: [
        "KGVBrowser",
        "kgv_rootd",
        "privapp-permissions-org.kgv.intelligence",
    ],
    optimize: {
        enabled: false,
    },
}

// Test build for phones without KGV FusionX: an ordinary, debuggable app (no system
// uid, test key), for trying the assistant and its phone control on stock ROMs. Not
// part of the ROM. Build with `m KGVIntelligenceTest`.
android_app {
    name: "KGVIntelligenceTest",
    defaults: ["SettingsLibDefaults"],
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: ":KGVIntelligenceTest-manifest",
    static_libs: ["kgv-browser-api"],
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}

genrule {
    name: "KGVIntelligenceTest-manifest",
    srcs: ["AndroidManifest.xml"],
    out: ["TestAndroidManifest.xml"],
    cmd: "sed -e 's/ android:sharedUserId=\"android.uid.system\"//' " +
        "-e 's/<application/<application android:debuggable=\"true\"/' $(in) > $(out)",
}

prebuilt_etc {
    name: "privapp-permissions-org.kgv.intelligence",
    system_ext_specific: true,
    sub_dir: "permissions",
    // Android reads only *.xml here; without the extension the allowlist is ignored and
    // system_server stops the boot over WRITE_SECURE_SETTINGS.
    filename: "privapp-permissions-org.kgv.intelligence.xml",
    src: "etc/privapp-permissions-org.kgv.intelligence.xml",
}

// Runs the assistant's root commands (rootd/kgv_rootd.cpp).
cc_binary {
    name: "kgv_rootd",
    system_ext_specific: true,
    srcs: ["rootd/kgv_rootd.cpp"],
    init_rc: ["rootd/kgv_rootd.rc"],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

// KGV Browser (browser/): the assistant's browser, which the agent drives in the
// background and the user can watch or take over. A separate app because Android
// doesn't allow WebView in system-uid processes; platform-signed, so only KGV X
// Intelligence may control it.
android_app {
    name: "KGVBrowser",
    srcs: ["browser/src/**/*.java"],
    resource_dirs: ["browser/res"],
    asset_dirs: ["browser/assets"],
    manifest: "browser/AndroidManifest.xml",
    static_libs: ["kgv-browser-api"],
    sdk_version: "current",
    certificate: "platform",
    system_ext_specific: true,
    optimize: {
        enabled: false,
    },
}

// KGV Browser's control interface (IKgvBrowser), for both apps.
java_library {
    name: "kgv-browser-api",
    srcs: ["browser/api/**/*.aidl"],
    aidl: {
        local_include_dirs: ["browser/api"],
    },
    sdk_version: "current",
}
